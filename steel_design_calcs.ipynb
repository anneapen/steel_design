   "source": [
    "def edge_distance (do:float,t:float,fy:float)->tuple[float,float]:\n",
    "    \"\"\"\n",
    "    Returns the maximum and minimum edge/end distance\n",
    "    \"\"\"\n",
    "    emin=1.5*do\n",
    "    eps=(250/fy)**(1/2)\n",
    "    emax=12*t*eps\n",
    "\n",
    "    return emin,emax"
   ]
